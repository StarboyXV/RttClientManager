@model Rtt.ClientManager.Web.Models.ClientFormViewModel
@{
    bool isEdit = Model.Client.ClientId > 0;
    ViewData["Title"] = isEdit ? "Edit Client" : "Create Client";
}

<h2>@ViewData["Title"]</h2>
<hr />

<form asp-action="@(isEdit ? "Edit" : "Create" )" asp-route-id="@Model.Client.ClientId" method="post">
    <input type="hidden" asp-for="Client.ClientId" />

    @if (!ViewData.ModelState.IsValid)
    {
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    <!-- Basic Client Details -->
    <div class="card mb-4">
        <div class="card-header fw-bold">Basic Details</div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label asp-for="Client.FirstName" class="form-label">First Name *</label>
                <input asp-for="Client.FirstName" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label asp-for="Client.LastName" class="form-label">Last Name *</label>
                <input asp-for="Client.LastName" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label asp-for="Client.Gender" class="form-label">Gender *</label>
                <select asp-for="Client.Gender" class="form-select" required>
                    <option value="">-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Client.IdNumber" class="form-label">ID / Passport Number</label>
                <input asp-for="Client.IdNumber" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Client.DateOfBirth" class="form-label">Date of Birth</label>
                <input asp-for="Client.DateOfBirth" type="date" class="form-control" />
            </div>
        </div>
    </div>

    <!-- Dynamic Addresses Section -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">Addresses</span>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addAddressRow()">+ Add Address</button>
        </div>
        <div class="card-body" id="addresses-container">
            @for (int i = 0; i < Model.Client.Addresses.Count; i++)
            {
            <div class="row g-2 mb-3 pb-3 border-bottom address-row">
                <div class="col-md-2">
                    <label class="form-label">Type *</label>
                    <select name="Client.Addresses[@i].AddressTypeId" class="form-select">
                        <option value="0">-- Type --</option>
                        @foreach (var t in Model.AddressTypes)
                        {
                        <option value="@t.Id" selected="@(Model.Client.Addresses[i].AddressTypeId == t.Id)">@t.Description</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Street Address *</label>
                    <input name="Client.Addresses[@i].StreetAddress" value="@Model.Client.Addresses[i].StreetAddress" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Suburb</label>
                    <input name="Client.Addresses[@i].Suburb" value="@Model.Client.Addresses[i].Suburb" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">City *</label>
                    <input name="Client.Addresses[@i].City" value="@Model.Client.Addresses[i].City" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Postal Code *</label>
                    <input name="Client.Addresses[@i].PostalCode" value="@Model.Client.Addresses[i].PostalCode" class="form-control" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-danger w-100" onclick="removeRow(this, 'address-row', 'Client.Addresses')">X</button>
                </div>
            </div>
            }
        </div>
    </div>

    <!-- Dynamic Contact Details Section -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">Contact Details</span>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addContactRow()">+ Add Contact</button>
        </div>
        <div class="card-body" id="contacts-container">
            @for (int i = 0; i < Model.Client.ContactDetails.Count; i++)
            {
            <div class="row g-2 mb-3 pb-3 border-bottom contact-row">
                <div class="col-md-4">
                    <label class="form-label">Contact Type *</label>
                    <select name="Client.ContactDetails[@i].ContactTypeId" class="form-select">
                        <option value="0">-- Type --</option>
                        @foreach (var t in Model.ContactTypes)
                        {
                        <option value="@t.Id" selected="@(Model.Client.ContactDetails[i].ContactTypeId == t.Id)">@t.Description</option>
                        }
                    </select>
                </div>
                <div class="col-md-7">
                    <label class="form-label">Value (Number / Email) *</label>
                    <input name="Client.ContactDetails[@i].ContactValue" value="@Model.Client.ContactDetails[i].ContactValue" class="form-control" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-danger w-100" onclick="removeRow(this, 'contact-row', 'Client.ContactDetails')">X</button>
                </div>
            </div>
            }
        </div>
    </div>

    <div class="mb-5">
        <button type="submit" class="btn btn-success px-4">Save Client</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </div>
</form>

@section Scripts {
<script>
        const addressTypeOptions = `@Html.Raw(string.Join("", Model.AddressTypes.Select(t => $"<option value='{t.Id}'>{t.Description}</option>")))`;
        const contactTypeOptions = `@Html.Raw(string.Join("", Model.ContactTypes.Select(t => $"<option value='{t.Id}'>{t.Description}</option>")))`;

        function addAddressRow() {
            const container = document.getElementById('addresses-container');
            const idx = container.querySelectorAll('.address-row').length;
            const html = `
                <div class="row g-2 mb-3 pb-3 border-bottom address-row">
                    <div class="col-md-2">
                        <label class="form-label">Type *</label>
                        <select name="Client.Addresses[${idx}].AddressTypeId" class="form-select">
                            <option value="0">-- Type --</option>
                            ${addressTypeOptions}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Street Address *</label>
                        <input name="Client.Addresses[${idx}].StreetAddress" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Suburb</label>
                        <input name="Client.Addresses[${idx}].Suburb" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">City *</label>
                        <input name="Client.Addresses[${idx}].City" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Postal Code *</label>
                        <input name="Client.Addresses[${idx}].PostalCode" class="form-control" />
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="button" class="btn btn-outline-danger w-100" onclick="removeRow(this, 'address-row', 'Client.Addresses')">X</button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
        }

        function addContactRow() {
            const container = document.getElementById('contacts-container');
            const idx = container.querySelectorAll('.contact-row').length;
            const html = `
                <div class="row g-2 mb-3 pb-3 border-bottom contact-row">
                    <div class="col-md-4">
                        <label class="form-label">Contact Type *</label>
                        <select name="Client.ContactDetails[${idx}].ContactTypeId" class="form-select">
                            <option value="0">-- Type --</option>
                            ${contactTypeOptions}
                        </select>
                    </div>
                    <div class="col-md-7">
                        <label class="form-label">Value (Number / Email) *</label>
                        <input name="Client.ContactDetails[${idx}].ContactValue" class="form-control" />
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="button" class="btn btn-outline-danger w-100" onclick="removeRow(this, 'contact-row', 'Client.ContactDetails')">X</button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
        }

        function removeRow(btn, rowClass, prefix) {
            const row = btn.closest('.' + rowClass);
            const container = row.parentElement;
            row.remove();
            // Re-index remaining inputs so ASP.NET Core MVC model binding stays contiguous
            container.querySelectorAll('.' + rowClass).forEach((el, newIdx) => {
                el.querySelectorAll('input, select').forEach(input => {
                    if (input.name) {
                        input.name = input.name.replace(new RegExp(prefix + '\\[\\d+\\]'), `${prefix}[${newIdx}]`);
                    }
                });
            });
        }
</script>
}